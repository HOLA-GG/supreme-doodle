<Window x:Class="SecurityMonitor.Soldier.Config.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tb="clr-namespace:Hardcodet.Wpf.TaskbarNotification;assembly=Hardcodet.NotifyIcon.Wpf"
        Title="Security Monitor - Soldado" Height="320" Width="420"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid>
        <tb:TaskbarIcon x:Name="notifyIcon"
                        IconSource="Assets/security_monitor_logo.png"
                        ToolTipText="Security Monitor Soldado (Activo)"
                        DoubleClickCommand="{Binding ShowWindowCommand}">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Configurar" Click="OpenConfig_Click" />
                    <Separator />
                    <MenuItem Header="Salir" Click="ExitApp_Click" />
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>

        <StackPanel Margin="20">
            <TextBlock Text="Ajustes del Agente Soldado" FontSize="18" FontWeight="Bold" Margin="0,0,0,20"/>
            
            <TextBlock Text="Dirección del Comandante (URL):" Margin="0,0,0,5"/>
            <TextBox x:Name="txtCommanderUrl" Padding="5" Margin="0,0,0,15"/>
            <TextBlock Text="Red WiFi Autorizada (SSID):" Margin="0,0,0,5"/>
            <TextBox x:Name="txtAuthorizedSsid" Padding="5" Margin="0,0,0,20"/>
            
            <Button Content="Guardar y Aplicar" Click="Save_Click" Padding="10" Background="#2980b9" Foreground="White" BorderThickness="0" FontWeight="Bold"/>

            <Border BorderBrush="#ddd" BorderThickness="1" Margin="0,15,0,0" Padding="10" CornerRadius="5">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Ellipse x:Name="statusDot" Width="10" Height="10" Fill="Gray" Margin="0,0,10,0"/>
                    <TextBlock x:Name="txtServiceStatus" Text="Estado del Servicio: Desconocido" FontSize="11" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Window>
